# Renders str (digits, dots and dashes) as big digits into BIG1, BIG2 and
# BIG3, and returns their width.
function big(str,   i, ch, w) {
	BIG1 = BIG2 = BIG3 = ""
	w = 0
	for ( i = 1 ; i <= length(str) ; i++ ) {
		ch = substr(str, i, 1)
		BIG1 = BIG1 BIG[ch, 1] ; BIG2 = BIG2 BIG[ch, 2] ; BIG3 = BIG3 BIG[ch, 3]
		w += vis(BIG[ch, 1])
	}
	return w
}

############################################################
# Building lines that contain escape codes, while keeping count of their
# visible width (in LW).

function lb() {
	LS = ""
	LW = 0
}

# Appends plain text s, in color c.
function la(s, c) {
	if ( s == "" ) return
	LS = LS c s ((c != "") ? RST : "")
	LW += vis(s)
}

# Appends a string that already contains escape codes and is w columns wide.
function lraw(s, w) {
	LS = LS s RST
	LW += w
}

function lpadto(w) {
	if ( LW < w ) {
		LS = LS rep(" ", w - LW)
		LW = w
	}
}

function lfill(w, g, c) {
	if ( LW < w ) la(rep(g, w - LW), c)
}
############################################################
# Terminal size

function get_terminal_size(   size, parts, cmd) {
	cmd = "stty size 2> /dev/null < /dev/tty"
	size = ""
	cmd | getline size
	close(cmd)

	if ( split(size, parts, " ") != 2 || parts[1] + 0 <= 0 ) {
		cmd = "stty -f /dev/tty size 2> /dev/null"
		size = ""
		cmd | getline size
		close(cmd)
		split(size, parts, " ")
	}
	if ( parts[1] + 0 <= 0 ) {
		# No controlling terminal, but stderr is usually still the screen.
		cmd = "stty size <&2 2> /dev/null"
		size = ""
		cmd | getline size
		close(cmd)
		split(size, parts, " ")
	}
	if ( parts[1] + 0 > 0 && parts[2] + 0 > 0 ) {
		LINES   = int(parts[1])
		COLUMNS = int(parts[2])
	} else {
		cmd = "tput lines 2> /dev/null"
		if ( (cmd | getline size) == 1 && size + 0 > 0 ) LINES = int(size)
		close(cmd)
		cmd = "tput cols 2> /dev/null"
		if ( (cmd | getline size) == 1 && size + 0 > 0 ) COLUMNS = int(size)
		close(cmd)
	}

	if ( OVERRIDE_COLUMNS > 0 ) COLUMNS = OVERRIDE_COLUMNS
	if ( OVERRIDE_LINES   > 0 ) LINES   = OVERRIDE_LINES

	# Nothing is ever printed in the last column: a character there leaves
	# the cursor waiting to wrap, and the next move would land a line lower.
	W = COLUMNS - 1
}

############################################################
# The latency scale: logarithmic, from SCALE_LO to SCALE_HI milliseconds.

function set_scale(lo, hi) {
	if ( lo <= 0 ) lo = 0.01
	if ( hi <= lo ) hi = lo * 40
	SCALE_LO = lo
	SCALE_HI = hi
	SCALE_L0 = log(lo)
	SCALE_SPAN = log(hi) - SCALE_L0
	SCALE_SET = 1
}

# Without --rttmin/--rttmax, the scale is set from the first reply: it sits a
# quarter of the way up the bars, leaving room for jitter below and for
# spikes up to about 7 times as slow above.
function scale_auto(rtt) {
	if ( rtt < 0.02 ) rtt = 0.02
	set_scale(nice(rtt / 1.6, 0), nice(rtt * 7.5, 1))
}

function pos(rtt) {
	if ( !SCALE_SET || rtt <= SCALE_LO ) return 0
	if ( rtt >= SCALE_HI ) return 1
	return (log(rtt) - SCALE_L0) / SCALE_SPAN
}

# Bar height, from 1 up to top (8 eighths per line of the bar).
function level(rtt, top) {
	return 1 + int(pos(rtt) * (top - 1) + 0.5)
}

############################################################
# Packets
#
# Every packet ends up either received (ST[seq] = "R") or lost ("L"),
# exactly once, in sequence order. A reply for a packet already counted as
# lost turns it into a late reply; a second reply for a received packet is a
# duplicate and is not counted again.

# Maps the 16-bit icmp_seq to a counter that keeps growing after it wraps.
function unwrap(raw,   s) {
	s = raw + SEQ_BASE
	if ( HAVE_SEQ ) {
		if ( s < LAST_SEQ - 32768 ) {
			SEQ_BASE += 65536
			s += 65536
		} else if ( s > LAST_SEQ + 32768 && SEQ_BASE >= 65536 ) {
			s -= 65536
		}
	}
	return s
}

# The first packet, either from the ping header style or the first event.
function start_seq(s) {
	if ( HAVE_SEQ ) return
	HAVE_SEQ = 1
	if ( FIRST_SEQ >= 0 && s >= FIRST_SEQ && s - FIRST_SEQ < 100000 ) {
		LAST_SEQ = FIRST_SEQ - 1
	} else {
		LAST_SEQ = s - 1
	}
	FIRST = LAST_SEQ + 1
}

# Every packet from LAST_SEQ+1 up to (and including) s is lost.
function lose_until(s) {
	while ( LAST_SEQ < s ) {
		LAST_SEQ++
		packet_lost(LAST_SEQ)
	}
}

function on_reply(raw, rtt, is_dup,   s) {
	banner()
	s = unwrap(raw)
	start_seq(s)
	if ( is_dup || (s <= LAST_SEQ && ST[s] == "R") ) {
		dups++
		DIRTY = 1
		return
	}
	if ( s <= LAST_SEQ ) {
		if ( ST[s] == "L" ) late_reply(s, rtt)
		return
	}
	lose_until(s - 1)
	LAST_SEQ = s
	packet_ok(s, rtt)
}

# "Request timeout for icmp_seq N" (BSD), "no answer yet for icmp_seq=N"
# (iputils with -O).
function on_timeout(raw,   s) {
	banner()
	s = unwrap(raw)
	start_seq(s)
	if ( s > LAST_SEQ ) lose_until(s)
}

function packet_ok(s, rtt) {
	msg_streak_end()
	ST[s] = "R"
	reply_stats(rtt)
	ring_put(s, rtt)
	arrival_put(s, rtt)
	timeline_add(rtt)
	consecutive_lost = 0
	LAST_EVENT_LOST = 0
	LAST_REPLY_T = NOW
	REPLY_TICK = TICKS
	draw_cell(s, rtt)
	prune()
}

function packet_lost(s) {
	ST[s] = "L"
	lost++
	consecutive_lost++
	LAST_EVENT_LOST = 1
	ring_put(s, -1)
	timeline_add(-1)
	draw_cell(s, -1)
}

function late_reply(s, rtt,   i, b) {
	ST[s] = "R"
	lost--
	late++
	reply_stats(rtt)
	arrival_put(s, rtt)
	DIRTY = 1
	consecutive_lost = 0
	LAST_REPLY_T = NOW
	REPLY_TICK = TICKS
	if ( LAST_N > 0 ) {
		i = s % LAST_N
		if ( RING_S[i] == s ) RING_V[i] = rtt
	}
	b = int((s - FIRST) / TL_SPAN)
	if ( b >= 0 && b <= TL_I ) {
		TL_L[b]--
		TL_N[b]++
		TL_SUM[b] += rtt
	}
	if ( (s in CB) && CB[s] == BAND_ID ) {
		band_lost--
		band_n++
		band_sum += rtt
		repaint_cell(s, rtt)
	}
}

# Forgets packets too old to receive a late reply.
function prune(   k) {
	if ( LAST_SEQ - PRUNED < 8192 ) return
	PRUNED = LAST_SEQ - 4096
	for ( k in ST ) if ( k + 0 < PRUNED ) delete ST[k]
	for ( k in CB ) if ( k + 0 < PRUNED ) {
		delete CB[k]
		delete CC[k]
	}
}

############################################################
# Statistics

function reply_stats(rtt,   k, d, m, idx) {
	if ( received == 0 || rtt < min_rtt ) min_rtt = rtt
	if ( received == 0 || rtt > max_rtt ) max_rtt = rtt
	if ( received > 0 ) {
		jit_sum += abs(rtt - last_rtt)
		jit_n++
	}
	received++
	sum_rtt += rtt
	last_rtt = rtt

	# Fine histogram, 2% wide buckets, for the percentiles.
	k = (rtt > 0.001) ? int(log(rtt / 0.001) / LOG_FH) : 0
	FH[k]++
	if ( FH[k] == 1 || rtt < FH_MINV[k] ) FH_MINV[k] = rtt
	if ( FH[k] == 1 || rtt > FH_MAXV[k] ) FH_MAXV[k] = rtt
	if ( received == 1 || k < FH_LO ) FH_LO = k
	if ( received == 1 || k > FH_HI ) FH_HI = k

	# Coarse histogram, 1-2-5 buckets, for the summary.
	if ( rtt < 0.01 ) rtt = 0.01
	d = floor_log10(rtt)
	m = rtt / 10 ^ d
	idx = 3 * d + ((m < 2) ? 0 : (m < 5) ? 1 : 2)
	H125[idx]++
	if ( received == 1 || idx < H125_LO ) H125_LO = idx
	if ( received == 1 || idx > H125_HI ) H125_HI = idx

	if ( !SCALE_SET ) scale_auto(rtt)
}

# Lower bound of a 1-2-5 bucket.
function h125_lo(idx,   d, r) {
	d = idx - 3 * int(idx / 3)
	if ( d < 0 ) d += 3
	r = (d == 0) ? 1 : (d == 1) ? 2 : 5
	return r * 10 ^ ((idx - d) / 3)
}

# Session percentile (q in 0..1), from the fine histogram.
function percentile(q,   k, need, acc, v) {
	if ( received == 0 ) return 0
	need = q * received
	acc = 0
	for ( k = FH_LO ; k <= FH_HI ; k++ ) {
		acc += FH[k]
		if ( acc >= need ) break
	}
	# The middle of the bucket, but never outside the values that fell in it:
	# a bucket holding a single value gives that value exactly.
	v = 0.001 * exp((k + 0.5) * LOG_FH)
	if ( k in FH_MINV ) {
		if ( v < FH_MINV[k] ) v = FH_MINV[k]
		if ( v > FH_MAXV[k] ) v = FH_MAXV[k]
	}
	return v
}

function loss_pct() {
	return (received + lost > 0) ? lost * 100 / (received + lost) : 0
}

function avg_rtt() {
	return (received > 0) ? sum_rtt / received : 0
}

function jitter() {
	return (jit_n > 0) ? jit_sum / jit_n : 0
}

# Mean opinion score (1 to 4.4) for a voice call over this path, from the
# simplified ITU-T E-model.
function mos(avg, jit, lossp,   eff, r) {
	eff = avg + 2 * jit + 10
	r = (eff < 160) ? 93.2 - eff / 40 : 93.2 - (eff - 120) / 10
	r -= 2.5 * lossp
	if ( r < 0 ) r = 0
	if ( r > 100 ) r = 100
	# Rounded as it is shown, so that the word always matches the number.
	return int((1 + 0.035 * r + 0.000007 * r * (r - 60) * (100 - r)) * 100 + 0.5) / 100
}

# How many of the five segments of the meter are lit, one step per word.
function mos_segs(m) {
	return (m >= 4.3) ? 5 : (m >= 4.0) ? 4 : (m >= 3.6) ? 3 : (m >= 3.1) ? 2 : 1
}

function mos_word(m) {
	if ( m >= 4.3 ) return "excellent"
	if ( m >= 4.0 ) return "good"
	if ( m >= 3.6 ) return "fair"
	if ( m >= 3.1 ) return "poor"
	return "bad"
}

function mos_color(m) {
	if ( m >= 4.0 ) return C_OK
	if ( m >= 3.6 ) return C_WARN
	return C_BAD
}

# The last LAST_N packets, indexed by seq.
function ring_put(s, v,   i) {
	if ( LAST_N <= 0 ) return
	i = s % LAST_N
	RING_V[i] = v
	RING_S[i] = s
}

# The replies in the order they arrived, for the jitter of the last LAST_N
# packets: a late reply is compared with the one that came just before it,
# as in the session jitter.
function arrival_put(s, v,   j) {
	if ( LAST_N <= 0 ) return
	j = ARR_N % (2 * LAST_N)
	ARR_S[j] = s
	ARR_V[j] = v
	ARR_N++
}

# Statistics of the last LAST_N packets, into R_N (packets), R_LOST, R_MIN,
# R_AVG, R_MAX, R_P95 and R_JIT.
function recent_stats(   s, i, v, n, prev, have_prev, sorted, sum, jsum, jn, a) {
	R_N = R_LOST = R_MIN = R_AVG = R_MAX = R_P95 = R_JIT = 0
	if ( LAST_N <= 0 || !HAVE_SEQ ) return
	n = sum = jsum = jn = have_prev = 0
	for ( s = LAST_SEQ - LAST_N + 1 ; s <= LAST_SEQ ; s++ ) {
		if ( s < FIRST ) continue
		i = s % LAST_N
		if ( RING_S[i] != s ) continue
		R_N++
		v = RING_V[i]
		if ( v < 0 ) {
			R_LOST++
			continue
		}
		n++
		sorted[n] = v
		sum += v
		if ( n == 1 || v < R_MIN ) R_MIN = v
		if ( n == 1 || v > R_MAX ) R_MAX = v
	}
	R_REPLIES = n
	for ( a = (ARR_N > 2 * LAST_N) ? ARR_N - 2 * LAST_N : 0 ; a < ARR_N ; a++ ) {
		i = a % (2 * LAST_N)
		s = ARR_S[i]
		if ( s <= LAST_SEQ - LAST_N || s < FIRST || RING_S[s % LAST_N] != s ) continue
		v = ARR_V[i]
		if ( have_prev ) {
			jsum += abs(v - prev)
			jn++
		}
		prev = v
		have_prev = 1
	}
	if ( n > 0 ) {
		R_AVG = sum / n
		sort_n(sorted, n)
		i = int(0.95 * n + 0.999)
		if ( i < 1 ) i = 1
		R_P95 = sorted[i]
	}
	if ( jn > 0 ) R_JIT = jsum / jn
}

# The whole session, kept in at most TL_CAP bins for the summary: when they
# fill up, neighbors are merged and each bin covers twice as many packets.
function timeline_add(v,   j) {
	if ( v >= 0 ) {
		TL_N[TL_I]++
		TL_SUM[TL_I] += v
	} else {
		TL_L[TL_I]++
	}
	if ( ++TL_C < TL_SPAN ) return
	TL_C = 0
	if ( ++TL_I < TL_CAP ) return
	for ( j = 0 ; j < TL_CAP / 2 ; j++ ) {
		TL_N[j]   = TL_N[2 * j]   + TL_N[2 * j + 1]
		TL_SUM[j] = TL_SUM[2 * j] + TL_SUM[2 * j + 1]
		TL_L[j]   = TL_L[2 * j]   + TL_L[2 * j + 1]
	}
	for ( j = TL_CAP / 2 ; j < TL_CAP ; j++ ) TL_N[j] = TL_SUM[j] = TL_L[j] = 0
	TL_I = TL_CAP / 2
	TL_SPAN *= 2
}
############################################################
# Output. Everything caused by one input line is collected in OUT and
# written at once, so the terminal never shows half of a redraw.

function flush() {
	if ( OUT != "" ) {
		# Terminals that know DEC mode 2026 show the update all at once,
		# never half drawn; the others ignore it.
		if ( IS_TERMINAL ) OUT = CSI "?2026h" OUT CSI "?2026l"
		printf("%s", OUT)
		OUT = ""
	}
	fflush()
}

# Moves the cursor to column x (counted from 0) of its line.
function go_col(x) {
	return "\r" ((x > 0) ? CSI x "C" : "")
}

# Splits s into display cells (a UTF-8 character each) in arr[1..n].
function cells_of(s, arr,   i, n, ch) {
	n = 0
	for ( i = 1 ; i <= length(s) ; i++ ) {
		ch = substr(s, i, 1)
		if ( n > 0 && ch ~ /^[\200-\277]$/ ) {
			arr[n] = arr[n] ch
		} else {
			arr[++n] = ch
		}
	}
	return n
}

############################################################
# The banner, printed once when ping says what it is pinging.

function on_header(line,   s, a, n, name, ip) {
	if ( HEADER_PARSED ) {
		message(line)
		return
	}
	HEADER_PARSED = 1
	name = ip = ""
	if ( line ~ /^PING6\(/ ) {
		# macOS ping6: PING6(56=40+8+8 bytes) 2001:db8::1 --> 2606:4700::1111
		n = split(line, a, " ")
		name = a[n]
		if ( match(line, /\([0-9]+=/) ) BYTES = substr(line, RSTART + 1, RLENGTH - 2)
		FIRST_SEQ = 0
	} else {
		# PING one.one.one.one (1.1.1.1): 56 data bytes
		# PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.
		s = substr(line, 6)
		name = s
		sub(/[ (].*/, "", name)
		if ( match(s, /\([^)]*\)/) ) ip = substr(s, RSTART + 1, RLENGTH - 2)
		if ( ip !~ /^[0-9A-Fa-f.:]+$/ || ip == name ) ip = ""
		if ( match(line, /[0-9]+(\([0-9]+\))? (data )?bytes/) ) {
			BYTES = substr(line, RSTART, RLENGTH)
			sub(/[^0-9].*/, "", BYTES)
		}
		# iputils counts packets from 1; BSD, macOS and busybox from 0. Their
		# headers all say "(address): 56 data bytes" or "from source: 56 data
		# bytes"; iputils says "56(84) bytes of data", or for IPv6, "(address)
		# 56 data bytes".
		FIRST_SEQ = (line ~ /bytes of data/ || (line ~ /data bytes/ && line !~ /(\)|from [^ ]+): [0-9]+ data bytes/)) ? 1 : 0
	}
	TARGET_NAME = sanitize(name)
	TARGET_IP = sanitize(ip)
	banner()
	DIRTY = 1
}

function banner(   left, right, bw, t, n, i, f, c, last, out, b0, b1) {
	if ( BANNER_DONE ) return
	BANNER_DONE = 1
	if ( TARGET_NAME == "" ) TARGET_NAME = sanitize(TARGET)
	if ( TARGET_NAME == "" ) TARGET_NAME = "?"

	bw = IS_TERMINAL ? W : greater(COLUMNS - 1, 60)
	left = " " G_DIAMOND " " MYNAME "  "
	b0 = vis(left) + 1
	left = left TARGET_NAME
	b1 = vis(left)
	if ( TARGET_IP != "" ) left = left "  " TARGET_IP
	right = ((BYTES != "") ? BYTES " bytes " G_SEP " " : "") \
		"every " fmt_num(INTERVAL) " s " G_SEP " " clock(NOW) " "
	if ( vis(left) + vis(right) + 2 > bw ) right = clock(NOW) " "
	if ( vis(left) + vis(right) + 2 > bw ) right = ""
	t = left rep(" ", bw - vis(left) - vis(right)) right
	n = cells_of(t, BANCELL)
	if ( n > bw ) n = bw

	out = ""
	if ( USE_COLOR && DEPTH != 16 ) {
		# A gradient from violet to teal under white text. The 256-color
		# palette is too coarse for a smooth one, so it gets three steps.
		out = rgb(245, 243, 255, 0)
		last = ""
		for ( i = 1 ; i <= n ; i++ ) {
			f = (n > 1) ? (i - 1) / (n - 1) : 0
			if ( DEPTH == 24 ) {
				c = rgb(109 - 95 * f, 40 + 76 * f, 217 - 73 * f, 1)
			} else {
				c = CSI "48;5;" ((f < 0.34) ? 56 : (f < 0.67) ? 62 : 31) "m"
			}
			if ( c != last && (DEPTH == 24 || last == "" || BANCELL[i] == " ") ) {
				out = out c
				last = c
			}
			if ( i == b0 ) out = out BOLD
			out = out BANCELL[i]
			if ( i == b1 ) out = out CSI "22m"
		}
	} else {
		# Reverse video reads well whatever the palette.
		if ( USE_COLOR ) out = CSI "7m"
		for ( i = 1 ; i <= n ; i++ ) {
			if ( USE_COLOR && i == b0 ) out = out BOLD
			out = out BANCELL[i]
			if ( USE_COLOR && i == b1 ) out = out CSI "22m"
		}
	}

	if ( IS_TERMINAL && ANCHOR != "none" ) {
		band_end()
		OUT = OUT RST "\r" CSI "J"
	}
	OUT = OUT out RST "\n"
	FOOT_VALID = 0
	if ( IS_TERMINAL ) ANCHOR = "fresh"
	DIRTY = 1
}

############################################################
# The graph: rows ("bands") with one bar per packet, the time and seq at the
# left, and the band average and loss at the right. A band is two lines tall,
# with 16 bar heights, or one line in compact mode, with 8.
#
# While a band is open (ANCHOR == "band"), the cursor waits on its bottom line
# where the next bar goes, and the status panel sits right below. Between
# bands (ANCHOR == "fresh"), the cursor is at the start of the line where the
# panel begins.

function band_layout() {
	TALL = (USE_UNICODE && !USE_COMPACT && LINES >= 16)
	GUT = (W >= 50) ? 10 : 0
	MARG = (W >= 64) ? (TALL ? 12 : 17) : 0
	CAP = W - GUT - MARG
	if ( CAP < 10 ) {
		GUT = MARG = 0
		CAP = W
	}
	if ( CAP < 1 ) CAP = 1
}

function band_start(s) {
	band_layout()
	BAND_ID++
	BAND_COL = 0
	band_n = band_sum = band_lost = 0
	FOOT_VALID = 0
	OUT = OUT RST "\r" CSI "J"
	if ( GUT ) OUT = OUT C_LABEL clock(NOW) RST " " C_FRAME G_AXIS RST
	if ( TALL ) {
		OUT = OUT "\n"
		if ( GUT ) OUT = OUT C_DIM lpad("#" (s % 10000000), 8) RST " " C_FRAME G_AXIS RST
	}
	ANCHOR = "band"
}

function band_end() {
	if ( ANCHOR != "band" ) return
	OUT = OUT RST "\n"
	FOOT_VALID = 0
	ANCHOR = "fresh"
}

function draw_cell(s, rtt) {
	if ( !IS_TERMINAL ) {
		plain_cell(s, rtt)
		return
	}
	if ( WINCH_PENDING ) winch_apply()
	if ( ANCHOR == "band" && BAND_COL >= CAP ) band_end()
	if ( ANCHOR != "band" ) band_start(s)
	CB[s] = BAND_ID
	CC[s] = BAND_COL
	if ( rtt < 0 ) {
		band_lost++
	} else {
		band_n++
		band_sum += rtt
	}
	OUT = OUT cell(rtt)
	BAND_COL++
	DIRTY = 1
}

# The escape codes that paint one bar at the cursor (on the bottom line of
# the band) and leave the cursor right after it.
function cell(rtt,   L, c) {
	if ( rtt < 0 ) {
		if ( TALL ) return C_LOSTBG CSI "A" " " CSI "B\b" RST C_LOST G_LOST RST
		return C_LOST G_LOST RST
	}
	c = bar_color(rtt, TALL)
	if ( TALL ) {
		L = level(rtt, 16)
		if ( L > 8 ) return c CSI "A" BLK[L - 8] CSI "B\b" BLK[8] RST
		return c CSI "A" " " CSI "B\b" BLK[L] RST
	}
	return c BLK[level(rtt, 8)] RST
}

# The color of a bar. Below 24-bit color, bars of the same height get the
# same color, rather than flickering between neighbors of the palette.
function bar_color(rtt, tall) {
	if ( DEPTH == 24 ) return heat(pos(rtt))
	if ( tall ) return heat((level(rtt, 16) - 1) / 15)
	return heat((level(rtt, 8) - 1) / 7)
}

# A late reply turns its cross into a bar, if it is still in the open band.
function repaint_cell(s, rtt) {
	if ( !IS_TERMINAL || ANCHOR != "band" ) return
	OUT = OUT go_col(GUT + CC[s]) cell(rtt) go_col(GUT + BAND_COL)
	DIRTY = 1
}

function margin_update(   x, n, p, top, bot) {
	if ( !MARG || ANCHOR != "band" ) return
	n = band_n + band_lost
	p = (n > 0) ? band_lost * 100 / n : 0
	top = (band_n > 0) ? heat(pos(band_sum / band_n)) lpad(fmt3(band_sum / band_n), 8) RST C_LABEL " ms" RST : rep(" ", 11)
	bot = loss_color(p) lpad(fmt_pct(p), 6) RST C_LABEL " lost" RST
	x = GUT + CAP + 1
	if ( TALL ) {
		OUT = OUT go_col(x) CSI "A" top CSI "B" go_col(x) bot
	} else {
		top = (band_n > 0) ? heat(pos(band_sum / band_n)) lpad(fmt3(band_sum / band_n), 5) RST C_LABEL " ms " RST : rep(" ", 9)
		OUT = OUT go_col(x) top loss_color(p) lpad(fmt_pct(p), 7) RST
	}
	OUT = OUT go_col(GUT + BAND_COL)
}

function loss_color(p) {
	if ( p <= 0 ) return C_DIM
	if ( p < 5 ) return C_WARN
	return C_BAD
}

############################################################
# Other lines (errors and warnings from ping) are printed between bands, with
# their time. A message that repeats while no reply comes back is printed
# once, and counted in the status panel.

function message(line,   norm) {
	line = sanitize(line)
	norm = line
	sub(/^\[[0-9.]+\] /, "", norm)
	gsub(/icmp_seq[= ][0-9]+ ?/, "", norm)
	if ( MSG_STREAK && norm == MSG_LAST ) {
		MSG_TIMES++
		DIRTY = 1
		return
	}
	msg_streak_end()
	MSG_LAST = norm
	MSG_TEXT = line
	MSG_TIMES = 1
	MSG_STREAK = 1
	if ( !IS_TERMINAL ) {
		plain_row_end()
		OUT = OUT C_LABEL clock(NOW) RST "  " msg_color(line) line RST "\n"
		return
	}
	if ( WINCH_PENDING ) winch_apply()
	band_end()
	OUT = OUT RST "\r" CSI "J" ((W >= 12) ? C_LABEL clock(NOW) RST "  " : "") msg_color(line) G_WARN " " cut(line, W - ((W >= 12) ? 12 : 2)) RST "\n"
	if ( ANCHOR != "none" ) ANCHOR = "fresh"
	FOOT_VALID = 0
	DIRTY = 1
}

function msg_color(line) {
	if ( line ~ /nreachable|[Nn]etwork is down|[Nn]o route|[Uu]nknown host|annot resolve|[Ff]ailure|[Ee]rror|[Ee]xceeded/ ) return C_BAD
	return C_WARN
}

function msg_streak_end() {
	if ( !MSG_STREAK ) return
	MSG_STREAK = 0
	if ( !IS_TERMINAL && MSG_TIMES >= 2 ) {
		plain_row_end()
		OUT = OUT C_LABEL clock(NOW) RST "  " C_DIM "Last message repeated " MSG_TIMES " times." RST "\n"
	}
	DIRTY = 1
}

############################################################
# When the output is not a terminal, rows of bars are printed whole, every
# LAST_N packets, each followed by the statistics.

function plain_cell(s, rtt) {
	if ( PROW && LAST_N > 0 && PROW_N >= LAST_N ) plain_row_end()
	if ( !PROW ) {
		if ( USE_LEGEND && SCALE_SET && !PLAIN_LEGEND ) {
			PLAIN_LEGEND = 1
			legend_line()
			OUT = OUT rep(" ", 9) LS "\n"
		}
		PROW = 1
		PROW_N = 0
		BAND_ID++
		band_n = band_sum = band_lost = 0
		OUT = OUT C_LABEL clock(NOW) RST " "
	}
	CB[s] = BAND_ID
	CC[s] = PROW_N
	if ( rtt < 0 ) {
		band_lost++
	} else {
		band_n++
		band_sum += rtt
	}
	OUT = OUT cell(rtt)
	PROW_N++
	if ( LAST_N > 0 && PROW_N >= LAST_N ) plain_row_end()
}

function plain_row_end(   n, p) {
	if ( !PROW ) return
	PROW = 0
	n = band_n + band_lost
	p = (n > 0) ? band_lost * 100 / n : 0
	if ( !(USE_RECENTSTATS && LAST_N > 0 && n == LAST_N) ) {
		OUT = OUT "  " ((band_n > 0) ? heat(pos(band_sum / band_n)) fmt3(band_sum / band_n) RST C_LABEL " ms" RST : C_LABEL "-" RST) \
			C_LABEL ", " RST loss_color(p) fmt_pct(p) RST C_LABEL " lost" RST
	}
	OUT = OUT "\n"
	if ( USE_GLOBALSTATS ) {
		session_row(1000)
		OUT = OUT "  " LS "\n"
	}
	if ( USE_RECENTSTATS && LAST_N > 0 ) {
		recent_row(1000)
		OUT = OUT "  " LS "\n"
	}
}

############################################################
# Terminal title and size

# The latency (or that it is missing) comes first, as tabs cut titles short.
function title_update(   t, st) {
	if ( !IS_TERMINAL || !USE_TITLE ) return
	st = status_state()
	if ( received + lost == 0 ) {
		t = MYNAME " " TARGET_NAME
	} else {
		if ( st == "down" ) {
			t = (consecutive_lost >= 3) ? consecutive_lost " lost in a row" : "no reply " fmt_dur(NOW - ((received > 0) ? LAST_REPLY_T : START_T))
		} else if ( st == "wait" ) {
			t = "waiting " fmt_dur(NOW - ((received > 0) ? LAST_REPLY_T : START_T))
		} else {
			t = fmt3(last_rtt) " ms"
		}
		t = t " " G_SEP " " TARGET_NAME
		if ( lost > 0 ) t = t " " G_SEP " " fmt_pct(loss_pct()) " lost"
	}
	if ( t == TITLE_LAST ) return
	TITLE_LAST = t
	OUT = OUT ESC "]2;" t BEL
}

# Resizing sends a burst of signals, so the work waits for a quiet moment.
function on_winch() {
	WINCH_PENDING = 1
	WINCH_TICK = TICKS
}

function winch_apply(   oc, ol) {
	WINCH_PENDING = 0
	oc = COLUMNS
	ol = LINES
	get_terminal_size()
	if ( COLUMNS == oc && LINES == ol ) return
	if ( ANCHOR == "band" && COLUMNS < oc ) {
		# The terminal may have rewrapped the open band: continue below it.
		OUT = OUT RST CSI "J" "\n"
		ANCHOR = "fresh"
	}
	FOOT_VALID = 0
	DIRTY = 1
}

# Back from ^Z: the shell has printed below the graph, so carry on from where
# the cursor is now.
function on_cont() {
	if ( ANCHOR == "band" ) {
		ANCHOR = "fresh"
		# Late replies must not repaint a band that is no longer there.
		BAND_ID++
	}
	if ( ANCHOR != "none" ) OUT = OUT RST "\r" CSI "J"
	OUT = OUT CSI "?25l"
	if ( USE_TITLE ) {
		OUT = OUT CSI "22;2t"
		TITLE_LAST = ""
	}
	FOOT_VALID = 0
	DIRTY = 1
}
############################################################
# The status panel, kept below the graph.
#
# The full panel, on terminals at least 65 columns wide and 14 lines tall:
#
#   ╭─ ● live ─ one.one.one.one  1.1.1.1 ─────────── 14:06:23 · up 4m12s ─╮
#   │      ╺┓ ╺━┓   ╻ ╻ ms │ session  min  9.81  avg  12.1  loss  0.40%  │
#   │       ┃ ┏━┛   ┗━┫    │ last 60  min  9.81  avg  11.9  loss     0%  │
#   │      ╺┻╸┗━╸ •   ╹    │ MOS 4.39 ▰▰▰▰▰ excellent   250 sent  1 lost │
#   ╰─ ▁▂▃▄▅▆▇█ 5 ms → 200 ms   ✕ lost ─────────────────────── prettyping ─╯
#
# Otherwise a slim panel: a status line, then the statistics lines.

function footer_tier() {
	if ( !IS_TERMINAL || LINES < 6 || W < 30 ) return 0
	if ( USE_UNICODE && W >= 64 && LINES >= 14 ) return 2
	return 1
}

# live, wait (late or losing replies), down (nothing for long), or start.
function status_state(   age) {
	if ( received + lost == 0 ) return (NOW - START_T > STALL) ? "wait" : "start"
	if ( consecutive_lost >= 3 ) return "down"
	age = NOW - ((received > 0) ? LAST_REPLY_T : START_T)
	if ( age > 3 * STALL ) return "down"
	if ( age > STALL || LAST_EVENT_LOST ) return "wait"
	return "live"
}

function status_chip(   age, d) {
	age = fmt_dur(NOW - ((received > 0) ? LAST_REPLY_T : START_T))
	if ( STATE == "live" ) {
		# The dot glows on each reply and fades over the next ticks.
		d = TICKS - REPLY_TICK
		la(G_DOT, (d <= 0) ? C_OK_HI : (d == 1) ? C_OK_MID : C_OK)
		la(" live", C_OK)
	} else if ( STATE == "start" ) {
		la(SPIN[1 + TICKS % SPIN_N] " starting", C_LABEL)
	} else if ( STATE == "wait" ) {
		la(SPIN[1 + TICKS % SPIN_N] " waiting " age, C_WARN)
	} else if ( consecutive_lost >= 3 ) {
		la(G_LOST " " consecutive_lost " lost in a row", C_BAD)
	} else {
		la(G_LOST " no reply " age, C_BAD)
	}
}

function footer_top(   chip, chipw, host, ip, right, rc, f) {
	lb()
	status_chip()
	chip = LS
	chipw = LW
	if ( MSG_STREAK ) {
		right = G_WARN " " cut(MSG_TEXT, int(W / 2)) ((MSG_TIMES > 1) ? " " G_TIMES MSG_TIMES : "")
		rc = msg_color(MSG_TEXT)
	} else {
		right = clock(NOW) " " G_SEP " up " fmt_dur(NOW - START_T)
		rc = C_LABEL
	}
	host = TARGET_NAME
	ip = (TARGET_IP != "") ? "  " TARGET_IP : ""

	# The corners, rules and spaces take 11 columns.
	f = W - 11 - chipw - vis(host) - vis(ip) - vis(right)
	if ( f < 1 && ip != "" ) {
		f += vis(ip)
		ip = ""
	}
	if ( f < 1 && !MSG_STREAK ) {
		f += vis(right)
		right = clock(NOW)
		f -= vis(right)
	}
	if ( f < 1 ) {
		f += vis(right) + 1
		right = ""
	}
	if ( f < 1 ) {
		host = cut(host, vis(host) + f - 1)
		f = 1
	}

	lb()
	la(G_TL G_H " ", C_FRAME)
	lraw(chip, chipw)
	la(" " G_H " ", C_FRAME)
	la(host, BOLD)
	la(ip, C_LABEL)
	la(" ", "")
	la(rep(G_H, f), C_FRAME)
	if ( right != "" ) {
		la(" ", "")
		la(right, rc)
		la(" " G_H G_TR, C_FRAME)
	} else {
		la(G_H G_H G_TR, C_FRAME)
	}
	return LS
}

# The key to the bars, into LS and LW.
function legend_line(   i) {
	lb()
	for ( i = 1 ; i <= 8 ; i++ ) la(BLK[i], heat((i - 1) / 7))
	if ( SCALE_SET ) {
		la(" " fmt_ms(SCALE_LO) " " G_ARROW " " fmt_ms(SCALE_HI), C_LABEL)
	} else {
		la(" scale set by the first reply", C_LABEL)
	}
	la("   ", "")
	la(G_LOST, C_LOST)
	la(" lost", C_LABEL)
}

function footer_bottom(   leg, legw, label, f) {
	leg = ""
	legw = 0
	if ( USE_LEGEND ) {
		legend_line()
		leg = LS
		legw = LW
	}
	label = MYNAME

	# The corners, rules and spaces take 8 columns.
	f = W - 8 - legw - vis(label)
	if ( f < 1 ) {
		f += vis(label) + 1
		label = ""
	}
	if ( f < 1 ) {
		f += legw + 1
		leg = ""
		legw = 0
	}

	lb()
	la(G_BL G_H, C_FRAME)
	if ( legw > 0 ) {
		la(" ", "")
		lraw(leg, legw)
	}
	la(" " rep(G_H, f), C_FRAME)
	if ( label != "" ) {
		la(" ", "")
		la(label, C_DIM)
		la(" " G_H G_BR, C_FRAME)
	} else {
		la(G_H G_H G_BR, C_FRAME)
	}
	return LS
}

# A row of statistics: the label, then as many fields as fit in w columns,
# picked by importance but shown in the usual order. The values are in SV.
function stats_row(label, w,   i, k, used) {
	used = LABW
	for ( i = 1 ; i <= 6 ; i++ ) {
		k = SPRIO[i]
		SINC[k] = (used + 2 + SFW[k] <= w)
		if ( SINC[k] ) used += 2 + SFW[k]
	}
	lb()
	la(rpad(label, LABW), C_LABEL)
	for ( i = 1 ; i <= 6 ; i++ ) {
		k = SORDER[i]
		if ( !SINC[k] ) continue
		la("  ", "")
		if ( k == "loss" ) {
			la("loss ", C_LABEL)
			la(lpad(fmt_pct(SV[k]), 6), loss_color(SV[k]))
		} else {
			la(k " ", C_LABEL)
			la(lpad((SV["n"] > 0) ? fmt3(SV[k]) : "-", 5), (k == "avg") ? BOLD : "")
		}
	}
}

function session_row(w) {
	SV["n"] = received
	SV["min"] = min_rtt
	SV["avg"] = avg_rtt()
	SV["p95"] = percentile(0.95)
	SV["max"] = max_rtt
	SV["jit"] = jitter()
	SV["loss"] = loss_pct()
	stats_row("session", w)
}

function recent_row(w) {
	recent_stats()
	SV["n"] = R_REPLIES
	SV["min"] = R_MIN
	SV["avg"] = R_AVG
	SV["p95"] = R_P95
	SV["max"] = R_MAX
	SV["jit"] = R_JIT
	SV["loss"] = (R_N > 0) ? R_LOST * 100 / R_N : 0
	stats_row("last " LAST_N, w)
}

# Call quality and the packet counts.
function quality_row(w,   m, on, i, c, f, nf) {
	lb()
	if ( LAST_N > 0 && USE_RECENTSTATS ) {
		recent_stats()
		m = mos(R_AVG, R_JIT, (R_N > 0) ? R_LOST * 100 / R_N : 0)
		if ( R_REPLIES == 0 ) m = 1
	} else {
		m = mos(avg_rtt(), jitter(), loss_pct())
		if ( received == 0 ) m = 1
	}
	la("MOS ", C_LABEL)
	if ( received + lost == 0 ) {
		la("   -", C_DIM)
		la(" " rep(G_MOS_OFF, 5) rep(" ", 10), C_FRAME)
	} else {
		# Without fresh replies, the verdict is greyed out like the digits.
		c = (STATE == "live") ? mos_color(m) : C_DIM
		la(sprintf("%.2f", m), c)
		la(" ", "")
		on = mos_segs(m)
		for ( i = 1 ; i <= 5 ; i++ ) la((i <= on) ? G_MOS_ON : G_MOS_OFF, (i <= on) ? c : C_FRAME)
		# Padded, so the counts after it stay put when the word changes.
		la(rpad(" " mos_word(m), 10), c)
	}

	nf = 0
	F_TXT[++nf] = (received + lost) ""
	F_LAB[nf] = " sent"
	F_COL[nf] = ""
	if ( lost > 0 ) {
		F_TXT[++nf] = lost ""
		F_LAB[nf] = " lost"
		F_COL[nf] = C_BAD
	}
	if ( dups > 0 ) {
		F_TXT[++nf] = dups ""
		F_LAB[nf] = " dup"
		F_COL[nf] = C_WARN
	}
	if ( late > 0 ) {
		F_TXT[++nf] = late ""
		F_LAB[nf] = " late"
		F_COL[nf] = C_WARN
	}
	for ( f = 1 ; f <= nf ; f++ ) {
		if ( LW + ((f == 1) ? 3 : 2) + vis(F_TXT[f] F_LAB[f]) > w ) break
		la((f == 1) ? "   " : "  ", "")
		la(F_TXT[f], F_COL[f])
		la(F_LAB[f], C_LABEL)
	}
}

# The latest reply, in big digits.
function footer_big(   v, unit) {
	unit = "ms"
	if ( received == 0 ) {
		v = "---"
	} else if ( last_rtt >= 9999.5 ) {
		v = fmt3(last_rtt / 1000)
		unit = "s "
	} else {
		v = fmt3(last_rtt)
	}
	BIGW = big(v)
	BIGUNIT = unit
	BIGC = (received > 0 && STATE == "live") ? heat(pos(last_rtt)) : C_DIM
}

function slim_top(   s) {
	lb()
	status_chip()
	if ( LW + 2 + vis(TARGET_NAME) <= W ) {
		la("  ", "")
		la(TARGET_NAME, BOLD)
	}
	if ( received > 0 ) {
		s = fmt3(last_rtt)
		if ( LW + 5 + vis(s) <= W ) {
			la("  ", "")
			la(s, (STATE == "live") ? heat(pos(last_rtt)) : C_DIM)
			la(" ms", C_LABEL)
		}
	}
	if ( MSG_STREAK ) {
		s = G_WARN " " MSG_TEXT ((MSG_TIMES > 1) ? " " G_TIMES MSG_TIMES : "")
		if ( LW + 2 < W ) {
			la("  ", "")
			la(cut(s, W - LW), msg_color(MSG_TEXT))
		}
	} else {
		s = "up " fmt_dur(NOW - START_T)
		if ( LW + 2 + vis(s) <= W ) la("  " s, C_LABEL)
	}
	return LS
}

function footer_build(   rows, nrows, i, sw) {
	FT = footer_tier()
	FN = 0
	if ( FT == 0 ) return
	STATE = status_state()

	if ( FT == 1 ) {
		FL[FN++] = slim_top()
		if ( USE_GLOBALSTATS ) {
			session_row(W)
			FL[FN++] = LS
		}
		if ( USE_RECENTSTATS && LAST_N > 0 ) {
			recent_row(W)
			FL[FN++] = LS
		}
		if ( USE_LEGEND && LINES >= 8 ) {
			legend_line()
			if ( LW <= W ) FL[FN++] = LS
		}
		return
	}

	FL[FN++] = footer_top()
	sw = W - 23
	nrows = 0
	if ( USE_GLOBALSTATS ) {
		session_row(sw)
		ROWS[++nrows] = LS
		ROWW[nrows] = LW
	}
	if ( USE_RECENTSTATS && LAST_N > 0 ) {
		recent_row(sw)
		ROWS[++nrows] = LS
		ROWW[nrows] = LW
	}
	quality_row(sw)
	ROWS[++nrows] = LS
	ROWW[nrows] = LW

	footer_big()
	for ( i = 1 ; i <= 3 ; i++ ) {
		lb()
		la(G_V, C_FRAME)
		la(" " rep(" ", 13 - BIGW), "")
		la((i == 1) ? BIG1 : (i == 2) ? BIG2 : BIG3, BIGC)
		la(" ", "")
		la((i == 1) ? BIGUNIT : "  ", C_LABEL)
		la(" ", "")
		la(G_V, C_FRAME)
		la(" ", "")
		if ( i <= nrows ) lraw(ROWS[i], ROWW[i])
		lpadto(W - 1)
		la(G_V, C_FRAME)
		FL[FN++] = LS
	}
	FL[FN++] = footer_bottom()
}

# Redraws the panel below the band (or at the fresh line), then puts the
# cursor back where the next bar goes. While the panel is still on screen as
# it was last drawn, only the lines that changed are written again.
function footer_draw(   i, s, same) {
	if ( ANCHOR == "none" ) return
	footer_build()
	same = (FOOT_VALID && FOOT_ANCHOR == ANCHOR && FOOT_BAND == BAND_ID && FOOT_N == FN && FOOT_W == W)
	s = RST
	if ( ANCHOR == "band" ) {
		if ( FN == 0 ) {
			# Clear anything left below, but not the rest of the band line:
			# nothing is ever printed in its last column.
			s = s go_col(W) CSI "J"
		} else if ( same ) {
			for ( i = 0 ; i < FN ; i++ ) s = s CSI "B" ((FL[i] != FOOT_L[i]) ? "\r" CSI "K" FL[i] : "")
			s = s CSI FN "A"
		} else {
			for ( i = 0 ; i < FN ; i++ ) s = s "\n" CSI "K" FL[i]
			s = s CSI "J" CSI FN "A"
		}
		s = s go_col(GUT + BAND_COL)
	} else if ( same ) {
		for ( i = 0 ; i < FN ; i++ ) s = s ((i > 0) ? CSI "B" : "") ((FL[i] != FOOT_L[i]) ? "\r" CSI "K" FL[i] : "")
		if ( FN > 1 ) s = s CSI (FN - 1) "A"
		s = s "\r"
	} else {
		s = s "\r" CSI "J"
		for ( i = 0 ; i < FN ; i++ ) s = s ((i > 0) ? "\n" : "") FL[i]
		if ( FN > 1 ) s = s CSI (FN - 1) "A"
		s = s "\r"
	}
	OUT = OUT s
	for ( i = 0 ; i < FN ; i++ ) FOOT_L[i] = FL[i]
	FOOT_VALID = 1
	FOOT_ANCHOR = ANCHOR
	FOOT_BAND = BAND_ID
	FOOT_N = FN
	FOOT_W = W
	FOOT_TOP = (FN > 0) ? FL[0] : ""
	FOOT_STATE = STATE
	FOOT_FT = FT
}

# On a tick only the first line changes (the clock, the age, the glowing
# dot), unless the status itself changed.
function footer_tick(   top) {
	if ( ANCHOR == "none" ) return
	if ( footer_tier() != FOOT_FT || status_state() != FOOT_STATE ) {
		footer_draw()
		return
	}
	if ( FN == 0 ) return
	STATE = FOOT_STATE
	top = (FT == 2) ? footer_top() : slim_top()
	if ( top == FOOT_TOP ) return
	FOOT_TOP = top
	FOOT_L[0] = top
	if ( ANCHOR == "band" ) {
		OUT = OUT RST CSI "B" "\r" CSI "K" top CSI "A" go_col(GUT + BAND_COL)
	} else {
		OUT = OUT RST "\r" CSI "K" top "\r"
	}
}
############################################################
# The summary, printed when ping stops.

# Remembers the line being built as field i, with a priority (the lowest is
# the first to go when they do not fit).
function fld(i, pr) {
	F_S[i] = LS
	F_W[i] = LW
	F_PR[i] = pr
}

# Appends fields 1..n separated by gap spaces, leaving out the least
# important ones until the line fits in w columns.
function la_fields(n, gap, w,   i, total, worst) {
	for ( i = 1 ; i <= n ; i++ ) F_IN[i] = 1
	while ( 1 ) {
		total = LW
		for ( i = 1 ; i <= n ; i++ ) {
			if ( F_IN[i] ) total += ((total > 0) ? gap : 0) + F_W[i]
		}
		if ( total <= w ) break
		worst = 0
		for ( i = 1 ; i <= n ; i++ ) {
			if ( F_IN[i] && (worst == 0 || F_PR[i] < F_PR[worst]) ) worst = i
		}
		if ( worst == 0 ) break
		F_IN[worst] = 0
	}
	for ( i = 1 ; i <= n ; i++ ) {
		if ( !F_IN[i] ) continue
		if ( LW > 0 ) la(rep(" ", gap), "")
		lraw(F_S[i], F_W[i])
	}
}

function card_line(s, w) {
	lb()
	la(G_V " ", C_FRAME)
	if ( w > 0 ) lraw(s, w)
	lpadto(CARD_W - 2)
	la(" " G_V, C_FRAME)
	OUT = OUT LS "\n"
}

function card_value(label, v, pr, i) {
	lb()
	la(label " ", C_LABEL)
	la(fmt3(v), (label == "avg") ? BOLD : "")
	fld(i, pr)
}

# The whole session in w columns, from the timeline bins, into TL1 (top
# line) and TL2 (bottom line, or the only one when not tall).
function timeline_render(w, tall,   nb, cols, c, b, b0, b1, n, sum, l, rtt, L, col) {
	TL1 = TL2 = ""
	nb = TL_I + ((TL_C > 0) ? 1 : 0)
	cols = (nb < w) ? nb : w
	for ( c = 0 ; c < cols ; c++ ) {
		b0 = int(c * nb / cols)
		b1 = int((c + 1) * nb / cols)
		if ( b1 <= b0 ) b1 = b0 + 1
		n = sum = l = 0
		for ( b = b0 ; b < b1 ; b++ ) {
			n += TL_N[b]
			sum += TL_SUM[b]
			l += TL_L[b]
		}
		if ( n == 0 || l * 5 >= n + l ) {
			TL1 = TL1 (tall ? C_LOSTBG " " RST : "")
			TL2 = TL2 C_LOST G_LOST RST
			continue
		}
		rtt = sum / n
		col = bar_color(rtt, tall)
		if ( tall ) {
			L = level(rtt, 16)
			TL1 = TL1 col ((L > 8) ? BLK[L - 8] : " ") RST
			TL2 = TL2 col ((L > 8) ? BLK[8] : BLK[L]) RST
		} else {
			TL2 = TL2 col BLK[level(rtt, 8)] RST
		}
	}
	return cols
}

# A histogram bar for frac (0..1) of w columns, in eighths of a cell.
function hbar(frac, w,   x, full, rem, s) {
	x = frac * w
	full = int(x)
	rem = int((x - full) * 8)
	s = rep(EIGHTH[8], full)
	if ( rem > 0 && full < w ) s = s EIGHTH[rem]
	if ( s == "" && frac > 0 ) s = USE_UNICODE ? EIGHTH[1] : "#"
	return s
}

# A range of milliseconds, in seconds from 1 s up.
function range_label(lo, hi) {
	if ( lo >= 1000 ) return fmt_num(lo / 1000) G_DASH fmt_num(hi / 1000) " s"
	return fmt_num(lo) G_DASH fmt_num(hi) " ms"
}

function bucket_label(idx,   lo, hi) {
	lo = h125_lo(idx)
	hi = h125_lo(idx + 1)
	# Anything faster than 0.01 ms is counted in the lowest bucket.
	if ( idx <= -6 ) return "<" fmt_num(hi) " ms"
	return range_label(lo, hi)
}

function summary(   iw, name, ip, right, f, big_ok, avg, v, unit, c, i, n, nb, xs, xw, tw, nrows, cols, idx, j, lbw, maxc, hbw, cnt, total, lab, gap, label) {
	total = received + lost
	CARD_W = IS_TERMINAL ? lesser(W, 100) : lesser(greater(COLUMNS - 1, 60), 100)
	iw = CARD_W - 4
	avg = avg_rtt()

	# ╭─ ◆ host  ip ──────────────────── 14:02:11 → 14:06:23 · 4m12s ─╮
	name = TARGET_NAME
	ip = (TARGET_IP != "") ? "  " TARGET_IP : ""
	right = clock(START_T) " " G_ARROW " " clock(NOW) " " G_SEP " " fmt_dur(NOW - START_T)
	f = CARD_W - 10 - vis(name) - vis(ip) - vis(right)
	if ( f < 1 && ip != "" ) {
		f += vis(ip)
		ip = ""
	}
	if ( f < 1 ) {
		f += vis(right) + 1
		right = ""
	}
	if ( f < 1 ) {
		name = cut(name, vis(name) + f - 1)
		f = 1
	}
	lb()
	la(G_TL G_H " ", C_FRAME)
	la(G_DIAMOND " ", C_OK)
	la(name, BOLD)
	la(ip, C_LABEL)
	la(" " rep(G_H, f), C_FRAME)
	if ( right != "" ) {
		la(" " right, C_LABEL)
		la(" " G_H G_TR, C_FRAME)
	} else {
		la(G_H G_H G_TR, C_FRAME)
	}
	OUT = OUT LS "\n"
	card_line("", 0)

	# The numbers, next to the average in big digits when there is room.
	big_ok = USE_UNICODE && iw >= 64
	tw = big_ok ? iw - 20 : iw

	n = 0
	if ( !big_ok && received > 0 ) {
		lb()
		la("avg ", C_LABEL)
		la(fmt3(avg), heat(pos(avg)) BOLD)
		la(" ms", C_LABEL)
		fld(++n, 9)
	}
	lb()
	la(total "", BOLD)
	la(" sent", C_LABEL)
	fld(++n, 7)
	lb()
	la(received "", "")
	la(" received", C_LABEL)
	fld(++n, 6)
	lb()
	la(lost "", (lost > 0) ? C_BAD : "")
	la(" lost ", C_LABEL)
	la("(", C_LABEL)
	la(fmt_pct(loss_pct()), loss_color(loss_pct()))
	la(")", C_LABEL)
	fld(++n, 8)
	nb = n
	if ( dups > 0 ) {
		lb()
		la(dups "", C_WARN)
		la(" duplicated", C_LABEL)
		fld(++n, 5)
	}
	if ( late > 0 ) {
		lb()
		la(late "", C_WARN)
		la(" late", C_LABEL)
		fld(++n, 4)
	}
	lb()
	la_fields(n, 3, tw)
	ROWS[1] = LS
	ROWW[1] = LW
	nrows = 1
	# The duplicate and late counts that did not fit get a row of their own,
	# below the others.
	xs = ""
	xw = 0
	for ( i = nb + 1 ; i <= n ; i++ ) {
		if ( F_IN[i] ) continue
		xs = xs ((xw > 0) ? "   " : "") F_S[i]
		xw += ((xw > 0) ? 3 : 0) + F_W[i]
	}

	if ( received > 0 ) {
		card_value("min", min_rtt, 5, 1)
		card_value("p50", percentile(0.50), 3, 2)
		card_value("p95", percentile(0.95), 4, 3)
		card_value("p99", percentile(0.99), 2, 4)
		card_value("max", max_rtt, 5, 5)
		lb()
		la_fields(5, 3, tw)
		ROWS[++nrows] = LS
		ROWW[nrows] = LW

		lb()
		la("jitter ", C_LABEL)
		la(fmt3(jitter()), "")
		la(" ms", C_LABEL)
		fld(1, 2)
		v = mos(avg, jitter(), loss_pct())
		c = mos_color(v)
		lb()
		la("MOS ", C_LABEL)
		la(sprintf("%.2f", v), c)
		la(" ", "")
		for ( i = 1 ; i <= 5 ; i++ ) la((i <= mos_segs(v)) ? G_MOS_ON : G_MOS_OFF, (i <= mos_segs(v)) ? c : C_FRAME)
		la(" " mos_word(v), c)
		fld(2, 1)
		lb()
		la_fields(2, 3, tw)
		ROWS[++nrows] = LS
		ROWW[nrows] = LW
	} else {
		lb()
		la("no replies", C_BAD)
		ROWS[++nrows] = LS
		ROWW[nrows] = LW
	}
	if ( xw > 0 ) {
		ROWS[++nrows] = xs
		ROWW[nrows] = xw
	}

	if ( big_ok ) {
		if ( received == 0 ) {
			v = "---"
			unit = ""
		} else if ( avg >= 9999.5 ) {
			v = fmt3(avg / 1000)
			unit = "s"
		} else {
			v = fmt3(avg)
			unit = "ms"
		}
		big(v)
		c = (received > 0) ? heat(pos(avg)) : C_DIM
		for ( i = 1 ; i <= 3 || i <= nrows ; i++ ) {
			lb()
			if ( i <= 3 ) {
				la(rep(" ", 13 - vis(BIG1)), "")
				la((i == 1) ? BIG1 : (i == 2) ? BIG2 : BIG3, c)
				la(" ", "")
				la((i == 1) ? unit : (i == 3 && received > 0) ? "avg" : "", C_LABEL)
			}
			lpadto(20)
			if ( i <= nrows ) lraw(ROWS[i], ROWW[i])
			card_line(LS, LW)
		}
	} else {
		for ( i = 1 ; i <= nrows ; i++ ) card_line(ROWS[i], ROWW[i])
	}

	# The session, squeezed into one row of bars.
	if ( received > 0 && TL_I * TL_SPAN + TL_C >= 2 ) {
		card_line("", 0)
		cols = timeline_render(iw, USE_UNICODE)
		if ( USE_UNICODE ) card_line(TL1, cols)
		card_line(TL2, cols)
		if ( cols >= 20 ) {
			lb()
			la(clock(START_T), C_LABEL)
			la(rep(" ", cols - 16), "")
			la(clock(NOW), C_LABEL)
			card_line(LS, LW)
		}
	}

	# How the replies were spread, in 1-2-5 buckets.
	if ( received > 0 ) {
		card_line("", 0)
		lbw = (lost > 0) ? 4 : 0
		maxc = lost
		for ( idx = H125_LO ; idx <= H125_HI ; idx++ ) {
			# (gawk 5.4 reads back garbage from an unset element once it has
			# been passed to a function, so they are never passed.)
			if ( idx in H125 ) {
				lab[idx] = bucket_label(idx)
				cnt = H125[idx]
				if ( cnt > maxc ) maxc = cnt
			} else {
				# A run of empty buckets shows as one row, so gaps are seen.
				j = idx
				while ( !((j + 1) in H125) ) j++
				gap[idx] = j
				lab[idx] = range_label(h125_lo(idx), h125_lo(j + 1))
			}
			lbw = greater(lbw, vis(lab[idx]))
			if ( idx in gap ) idx = gap[idx]
		}
		hbw = iw - lbw - 10
		for ( idx = H125_LO ; hbw >= 1 && idx <= H125_HI ; idx++ ) {
			lb()
			la(lpad(lab[idx], lbw), (idx in gap) ? C_DIM : C_LABEL)
			la("  ", "")
			if ( idx in gap ) {
				lpadto(lbw + 2 + hbw + 2)
				la(lpad("0%", 6), C_DIM)
				idx = gap[idx]
			} else {
				cnt = H125[idx]
				la(hbar(cnt / maxc, hbw), heat(pos(sqrt(h125_lo(idx) * h125_lo(idx + 1)))))
				lpadto(lbw + 2 + hbw + 2)
				la(lpad(sprintf("%.1f%%", cnt * 100 / total), 6), "")
			}
			card_line(LS, LW)
		}
		if ( lost > 0 && hbw >= 1 ) {
			lb()
			la(lpad("lost", lbw), C_LABEL)
			la("  ", "")
			la(hbar(lost / maxc, hbw), C_BAD)
			lpadto(lbw + 2 + hbw + 2)
			la(lpad(sprintf("%.1f%%", lost * 100 / total), 6), C_BAD)
			card_line(LS, LW)
		}
	}

	# ╰──────────────────────────────────────────── prettyping 2.0.0 ─╯
	label = MYNAME " " VERSION
	f = CARD_W - 5 - vis(label)
	lb()
	if ( f < 1 ) {
		la(G_BL rep(G_H, CARD_W - 2) G_BR, C_FRAME)
	} else {
		la(G_BL rep(G_H, f) " ", C_FRAME)
		la(label, C_DIM)
		la(" " G_H G_BR, C_FRAME)
	}
	OUT = OUT LS "\n"
}

############################################################
# Lines from ping

# What ping prints after its "--- host ping statistics ---" line is replaced
# by the summary. Only its count of transmitted packets is used: it tells
# about packets at the end that were lost without a word (iputils, busybox
# and ping6 print nothing for those).
function ping_summary(line,   a, tx, rx, room, last) {
	# "5 packets transmitted, 4 received", or from httping "5 connects, 4 ok"
	if ( line !~ /packets transmitted|^[0-9]+ connects, / ) return
	split(line, a, " ")
	tx = a[1] + 0
	rx = -1
	if ( match(line, /[0-9]+ (packets )?received|[0-9]+ ok/) ) rx = substr(line, RSTART, RLENGTH) + 0
	# Whatever was not understood here, there are no more losses than ping says.
	room = (rx >= 0) ? tx - rx - lost : tx
	# On ^C, the packet that was still in flight is counted as transmitted.
	if ( !(COUNT > 0 && tx >= COUNT) ) tx--
	if ( tx <= 0 ) return
	if ( !HAVE_SEQ ) start_seq((FIRST_SEQ >= 0) ? FIRST_SEQ : 0)
	last = FIRST + tx - 1
	if ( last - LAST_SEQ > room ) last = LAST_SEQ + room
	if ( last > LAST_SEQ ) {
		banner()
		lose_until(last)
	}
}

function handle_line(line,   raw, rtt, x) {
	if ( IN_SUMMARY ) {
		ping_summary(line)
		return
	}
	if ( SKIP_DUMP ) {
		SKIP_DUMP = 0
		if ( line ~ /^ *[0-9a-fA-F]+ +[0-9a-fA-F]+ +[0-9a-fA-F]+ / ) return
	}

	if ( line ~ /^(\[[0-9.]+\] |[0-9][0-9]:[0-9][0-9]:[0-9][0-9][.][0-9]+ )?[0-9]+ bytes from .*[:,] (icmp_)?[rs]eq=[0-9]+ .*time[=<] *[0-9.]+ *ms/ ) {
		# 64 bytes from 8.8.8.8: icmp_seq=1 ttl=49 time=184 ms
		# 64 bytes from 1.1.1.1: seq=0 ttl=63 time=8.585 ms (busybox)
		# [1792972566.494012] 64 bytes from 1.1.1.1: icmp_seq=1 ttl=63 time=13.3 ms (iputils -D)
		# 09:05:29.509306 64 bytes from 1.1.1.1: icmp_seq=0 ttl=64 time=0.075 ms (macOS --apple-time)
		match(line, /[rs]eq=[0-9]+/)
		raw = substr(line, RSTART + 4, RLENGTH - 4) + 0
		match(line, /time[=<] *[0-9.]+/)
		x = substr(line, RSTART + 5, RLENGTH - 5)
		rtt = x + 0
		on_reply(raw, rtt, line ~ /DUP!/)
	} else if ( line ~ /onnected to.*, seq=[0-9]+ time= *[0-9.]+ *ms/ ) {
		# Sample line from httping:
		# connected to 200.149.119.168:80 (273 bytes), seq=0 time=129.86 ms
		match(line, /seq=[0-9]+/)
		raw = substr(line, RSTART + 4, RLENGTH - 4) + 0
		match(line, /time= *[0-9.]+/)
		x = substr(line, RSTART + 5, RLENGTH - 5)
		rtt = x + 0
		on_reply(raw, rtt, 0)
	} else if ( line ~ /^Request timeout for icmp_seq [0-9]+/ ) {
		# Reply timeout is printed on Mac OS X.
		x = line
		sub(/^Request timeout for icmp_seq /, "", x)
		on_timeout(x + 0)
	} else if ( line ~ /^(\[[0-9.]+\] )?no answer yet for icmp_seq=[0-9]+/ ) {
		# iputils with -O.
		x = line
		sub(/^(\[[0-9.]+\] )?no answer yet for icmp_seq=/, "", x)
		on_timeout(x + 0)
	} else if ( line ~ /^PING / || line ~ /^PING6\(/ ) {
		on_header(line)
	} else if ( line ~ /^--- .* ping6? statistics ---/ ) {
		IN_SUMMARY = 1
	} else if ( line == "" ) {
		# Do nothing on blank lines.
	} else if ( line == "error shutting down ssl" ) {
		# Common error message when using httping, ignore it.
	} else if ( line ~ /^Vr HL TOS/ ) {
		# BSD ping follows an ICMP error with a dump of the IP header, over
		# this line and the next.
		SKIP_DUMP = 1
	} else {
		message(line)
		# From 10.1.1.160 icmp_seq=22 Destination Host Unreachable
		if ( line ~ /icmp_seq=[0-9]+ .*([Uu]nreachable|[Ee]xceeded)/ ) {
			x = line
			sub(/.*icmp_seq=/, "", x)
			on_timeout(x + 0)
		}
	}
}

function on_tick() {
	TICKS++
	NOW = now()
	if ( WINCH_PENDING && TICKS - WINCH_TICK >= 2 ) winch_apply()
	# ping6 prints nothing at all while nothing comes back.
	if ( !BANNER_DONE && NOW - START_T >= 2 ) banner()
	if ( !DIRTY && !WINCH_PENDING ) {
		footer_tick()
		title_update()
	}
}

############################################################
# Initializations
BEGIN {
	LOG10 = log(10)
	LOG_FH = log(1.02)
	NICE_N = split("1 1.2 1.5 2 2.5 3 4 5 6 8", NICE, " ")

	IS_TERMINAL += 0
	USE_COLOR += 0
	DEPTH += 0
	USE_MULTICOLOR += 0
	USE_UNICODE += 0
	USE_COMPACT += 0
	USE_LEGEND += 0
	USE_GLOBALSTATS += 0
	USE_RECENTSTATS += 0
	USE_SUMMARY += 0
	USE_TITLE += 0
	USE_CLEAR += 0
	LAST_N = int(LAST_N)
	OVERRIDE_COLUMNS = int(OVERRIDE_COLUMNS)
	OVERRIDE_LINES = int(OVERRIDE_LINES)
	RTT_MIN += 0
	RTT_MAX += 0
	COUNT = int(COUNT)
	INTERVAL += 0
	if ( INTERVAL <= 0 ) INTERVAL = 1
	TICK += 0

	init_colors()
	init_glyphs()

	# These are sane defaults, in case we cannot query the actual terminal size
	LINES    = 24
	COLUMNS  = 80
	if ( IS_TERMINAL ) {
		get_terminal_size()
	} else {
		if ( OVERRIDE_COLUMNS > 0 ) COLUMNS = OVERRIDE_COLUMNS
		if ( OVERRIDE_LINES   > 0 ) LINES   = OVERRIDE_LINES
		W = COLUMNS - 1
	}
	TALL = 0

	clock_init()
	STALL = INTERVAL * 2 + 0.5
	if ( STALL < 2 ) STALL = 2

	if ( RTT_MIN > 0 && RTT_MAX > 0 ) {
		set_scale(RTT_MIN, RTT_MAX)
	} else if ( RTT_MIN > 0 ) {
		set_scale(RTT_MIN, RTT_MIN * 40)
	} else if ( RTT_MAX > 0 ) {
		set_scale(RTT_MAX / 40, RTT_MAX)
	}

	FIRST_SEQ = -1
	ANCHOR = "none"
	TL_CAP = 512
	TL_SPAN = 1
	TL_I = TL_C = 0
	received = lost = dups = late = 0

	LABW = greater(8, vis("last " LAST_N))
	split("min avg p95 max jit loss", SORDER, " ")
	split("avg loss max min jit p95", SPRIO, " ")
	SFW["min"] = SFW["avg"] = SFW["p95"] = SFW["max"] = SFW["jit"] = 9
	SFW["loss"] = 11

	if ( IS_TERMINAL ) {
		# Start on a clean screen; what was on it stays in the scrollback.
		if ( USE_CLEAR ) OUT = OUT CSI "H" CSI "2J"
		OUT = OUT CSI "?25l"
		if ( USE_TITLE ) OUT = OUT CSI "22;2t"
		flush()
	}
}

############################################################
# Main loop
{
	if ( $0 == "TICK" ) {
		on_tick()
	} else {
		refresh_now()
		if ( $0 == "SIGWINCH" ) {
			on_winch()
		} else if ( $0 == "SIGCONT" ) {
			on_cont()
		} else {
			handle_line($0)
		}
	}

	if ( DIRTY && IS_TERMINAL && !WINCH_PENDING ) {
		DIRTY = 0
		margin_update()
		footer_draw()
		title_update()
	}

	# Not needed when the output is a terminal, but does not hurt either.
	flush()
}

END {
	NOW = now()
	if ( IS_TERMINAL ) {
		if ( WINCH_PENDING ) winch_apply()
		band_end()
		if ( ANCHOR != "none" ) OUT = OUT RST "\r" CSI "J"
	}
	msg_streak_end()
	plain_row_end()
	if ( USE_SUMMARY && received + lost > 0 ) summary()
	if ( IS_TERMINAL ) {
		OUT = OUT RST CSI "?25h"
		if ( USE_TITLE ) OUT = OUT CSI "23;2t"
	}
	flush()
}'

# Warning! Ugly code ahead!
# The code is so ugly that the comments explaining it are
# bigger than the code itself!
#
# Suppose this:
#
#   cmd_a | cmd_b &
#
# I need the PID of cmd_a. How can I get it?
# In bash, $! will give me the PID of cmd_b.
#
# So, I came up with this ugly solution: open a subshell, like this:
#
# (
# 	cmd_a &
# 	echo "This is the PID I want $!"
# 	wait
# ) | cmd_b


# Ignore Ctrl+C here.
# If I don't do this, this shell script is killed before
# ping and awk can finish their work.
trap '' INT

prepare_terminal
trap 'on_fatal_signal 143' TERM
trap 'on_fatal_signal 129' HUP
if [[ "${IS_TERMINAL}" = 1 ]] ; then
	# On ^Z, the middle subshell below stops everything once it has handed the
	# terminal back; this shell must not stop before that.
	trap ':' TSTP
fi

# Now the ugly code.
(
	"${PING_BIN}" "${PING_PARAMS[@]}" &
	# Exit with the status of ping itself.
	wait "$!"
) 2>&1 | (
	if [ "${IS_TERMINAL}" = 1 ]; then
		trap on_tstp TSTP
		trap on_cont CONT

		# A heartbeat, so the panel keeps time even while ping is silent, and
		# the notice of a terminal size change. bash 4 and later run a WINCH
		# trap only once the builtin it interrupted returns, which the read
		# loop below may not do for a long time; this wait returns at once.
		# Each echo is a single write of a whole line, like those of the loop
		# below, so they never land in the middle of a line.
		(
			trap "echo SIGWINCH" WINCH
			while : ; do
				sleep "${TICK}" > /dev/null 2>&1 &
				wait "$!"
				status="$?"
				if [ "${status}" != 0 ] && [ "${status}" -le 128 ] ; then
					exit
				fi
				echo TICK || exit
			done
		) &
		TICKER="$!"
	fi

	while IFS= read -r line || [ -n "${line}" ]; do
		printf '%s\n' "${line}"
	done

	if [ -n "${TICKER}" ]; then
		kill "${TICKER}" 2> /dev/null
		wait "${TICKER}" 2> /dev/null
	fi
) 2>&1 | "${AWK_BIN}" "${AWK_PARAMS[@]}" \
	-v MYNAME="${MYNAME}" \
	-v VERSION="${VERSION}" \
	-v IS_TERMINAL="${IS_TERMINAL}" \
	-v USE_COLOR="${USE_COLOR}" \
	-v DEPTH="${COLOR_DEPTH}" \
	-v THEME="${THEME}" \
	-v USE_MULTICOLOR="${USE_MULTICOLOR}" \
	-v USE_UNICODE="${USE_UNICODE}" \
	-v USE_COMPACT="${USE_COMPACT}" \
	-v USE_LEGEND="${USE_LEGEND}" \
	-v USE_GLOBALSTATS="${USE_GLOBALSTATS}" \
	-v USE_RECENTSTATS="${USE_RECENTSTATS}" \
	-v USE_SUMMARY="${USE_SUMMARY}" \
	-v USE_TITLE="${USE_TITLE}" \
	-v USE_CLEAR="${USE_CLEAR}" \
	-v LAST_N="${LAST_N}" \
	-v OVERRIDE_COLUMNS="${OVERRIDE_COLUMNS}" \
	-v OVERRIDE_LINES="${OVERRIDE_LINES}" \
	-v RTT_MIN="${RTT_MIN}" \
	-v RTT_MAX="${RTT_MAX}" \
	-v COUNT="${COUNT}" \
	-v INTERVAL="${INTERVAL}" \
	-v TICK="${TICK}" \
	-v TARGET="${TARGET}" \
	"${AWK_PROG}"

STATUS="${PIPESTATUS[0]}"
restore_terminal
exit "${STATUS}"
