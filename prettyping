#!/usr/bin/env bash
#
# Written by Denilson Figueiredo de Sá <denilsonsa@gmail.com>
# MIT license
#
# Requirements:
# * bash (3.2 or newer)
# * awk (works with GNU awk, nawk/BWK awk, busybox awk, mawk)
# * ping (from iputils, BSD/macOS, busybox, or any other with similar output)
#
# More information:
# https://denilsonsa.github.io/prettyping/
# https://github.com/denilsonsa/prettyping
# https://old.reddit.com/r/linux/comments/1op98a/prettypingsh_a_better_ui_for_watching_ping/
# Third-party demonstration video: https://www.youtube.com/watch?v=ziEMY1BcikM

# TODO: Handle when a single message is spread over multiple lines. Specially,
# like in this case: https://bitbucket.org/denilsonsa/small_scripts/issue/5
#
# TODO: Implement audible ping.

VERSION="2.0.0"

print_help() {
	cat << EOF
Usage: $MYNAME [prettyping parameters] <standard ping parameters>

This script is a wrapper around the system's "ping" tool. It will substitute
each ping response line by a colored bar, giving a very compact overview of
the ping responses.

Each bar's height and color show the round-trip time on a logarithmic scale,
which is set from the first reply unless --rttmin or --rttmax are given. Lost
packets are drawn as red crosses. A live panel at the bottom shows the latest
reply and the statistics, and a summary is printed when ping stops.

prettyping parameters:
  --[no]color        Enable/disable color output. (default: enabled, unless the
                       NO_COLOR environment variable is set)
  --colors <n>       Color depth: 16, 256 or 24 (truecolor). (default: auto)
  --theme <t>        Colors for a dark or light background: dark, light or
                       auto, which asks the terminal. (default: auto)
  --[no]multicolor   Enable/disable the latency color gradient. Has no effect
                       if color is disabled. (default: enabled)
  --[no]unicode      Enable/disable unicode characters. (default: enabled)
  --[no]compact      Draw each row of bars one line tall instead of two.
                       (default: disabled)
  --[no]legend       Enable/disable the latency legend. (default: enabled)
  --[no]globalstats  Enable/disable the session statistics. (default: enabled)
  --[no]recentstats  Enable/disable the "last n" statistics. (default: enabled)
  --[no]summary      Enable/disable the summary printed when ping stops.
                       (default: enabled)
  --[no]title        Enable/disable showing the latency in the terminal title.
                       (default: enabled)
  --[no]clear        Enable/disable clearing the screen at the start.
                       (default: enabled)
  --[no]terminal     Force the output designed to a terminal. (default: auto)
  --last <n>         Use the last "n" pings at the statistics line. (default: 60)
  --columns <n>      Override auto-detection of terminal dimensions.
  --lines <n>        Override auto-detection of terminal dimensions.
  --rttmin <n>       Minimum RTT represented in the graph. (default: auto)
  --rttmax <n>       Maximum RTT represented in the graph. (default: auto)
  --awkbin <exec>    Override the awk interpreter. (default: awk)
  --pingbin <exec>   Override the ping tool. (default: ping)
  --version          Print the version and exit.

ping parameters handled by prettyping:
  -a  Audible ping is not implemented yet.
  -f  Flood mode is not allowed in prettyping.
  -q  Quiet output is not allowed in prettyping.
  -R  Record route mode is not allowed in prettyping.
  -v  Verbose output seems to be the default mode in ping.

All other parameters are passed directly to ping.
EOF
}

is_uint() {
	local re='^[0-9]+$'
	[[ "$1" =~ $re ]]
}

is_number() {
	local re='^([0-9]+[.]?[0-9]*|[.][0-9]+)$'
	[[ "$1" =~ $re ]]
}

die() {
	echo "${MYNAME}: $*" >&2
	exit 1
}

# Thanks to people at #bash who pointed me at
# https://web.archive.org/web/20100301171512/https://bash-hackers.org/wiki/doku.php/scripting/posparams
parse_arguments() {
	USE_COLOR=1
	USE_MULTICOLOR=1
	USE_UNICODE=1
	USE_COMPACT=0
	USE_LEGEND=1
	USE_GLOBALSTATS=1
	USE_RECENTSTATS=1
	USE_SUMMARY=1
	USE_TITLE=1
	USE_CLEAR=1
	FORCED_COLOR=0
	COLOR_DEPTH=auto
	THEME=auto

	if [ -t 1 ]; then
		IS_TERMINAL=1
	else
		IS_TERMINAL=0
	fi
	# A terminal that cannot move its cursor gets the plain output.
	case "${TERM:-dumb}" in
		dumb ) IS_TERMINAL=0 ;;
	esac

	LAST_N=60
	OVERRIDE_COLUMNS=0
	OVERRIDE_LINES=0
	RTT_MIN=auto
	RTT_MAX=auto

	PING_BIN="ping"
	#PING_BIN="./mockping.sh"
	PING_PARAMS=( )

	AWK_BIN="awk"
	AWK_PARAMS=( )

	while [[ $# != 0 ]] ; do
		case "$1" in
			-h | -help | --help )
				print_help
				exit
				;;
			-version | --version )
				echo "prettyping ${VERSION}"
				exit
				;;

			# Forbidden ping parameters within prettyping:
			-f )
				die "You can't use the -f (flood) option."
				;;
			-R )
				# -R prints extra information at each ping response.
				die "You can't use the -R (record route) option."
				;;
			-q )
				die "You can't use the -q (quiet) option."
				;;
			-v )
				# -v enables verbose output. However, it seems the output with
				# or without this option is the same. Anyway, prettyping will
				# strip this parameter.
				;;
			# Note:
			#  Small values for -s parameter prevents ping from being able to
			#  calculate RTT.

			# New parameters:
			-a )
				# TODO: Implement audible ping for responses or for missing packets
				;;

			-color         | --color         ) USE_COLOR=1 ; FORCED_COLOR=1 ;;
			-nocolor       | --nocolor       ) USE_COLOR=0 ;;
			-multicolor    | --multicolor    ) USE_MULTICOLOR=1 ;;
			-nomulticolor  | --nomulticolor  ) USE_MULTICOLOR=0 ;;
			-unicode       | --unicode       ) USE_UNICODE=1 ;;
			-nounicode     | --nounicode     ) USE_UNICODE=0 ;;
			-compact       | --compact       ) USE_COMPACT=1 ;;
			-nocompact     | --nocompact     ) USE_COMPACT=0 ;;
			-legend        | --legend        ) USE_LEGEND=1 ;;
			-nolegend      | --nolegend      ) USE_LEGEND=0 ;;
			-globalstats   | --globalstats   ) USE_GLOBALSTATS=1 ;;
			-noglobalstats | --noglobalstats ) USE_GLOBALSTATS=0 ;;
			-recentstats   | --recentstats   ) USE_RECENTSTATS=1 ;;
			-norecentstats | --norecentstats ) USE_RECENTSTATS=0 ;;
			-summary       | --summary       ) USE_SUMMARY=1 ;;
			-nosummary     | --nosummary     ) USE_SUMMARY=0 ;;
			-title         | --title         ) USE_TITLE=1 ;;
			-notitle       | --notitle       ) USE_TITLE=0 ;;
			-clear         | --clear         ) USE_CLEAR=1 ;;
			-noclear       | --noclear       ) USE_CLEAR=0 ;;
			-terminal      | --terminal      ) IS_TERMINAL=1 ;;
			-noterminal    | --noterminal    ) IS_TERMINAL=0 ;;

			-awkbin  | --awkbin  | \
			-pingbin | --pingbin | \
			-colors  | --colors  | \
			-theme   | --theme   | \
			-last    | --last    | \
			-columns | --columns | \
			-lines   | --lines   | \
			-rttmin  | --rttmin  | \
			-rttmax  | --rttmax  )
				if [[ $# -lt 2 ]] ; then
					die "The $1 option needs a value."
				fi
				case "$1" in
					*awkbin  ) AWK_BIN="$2" ;;
					*pingbin ) PING_BIN="$2" ;;
					*colors  ) COLOR_DEPTH="$2" ;;
					*theme   ) THEME="$2" ;;
					*last    ) LAST_N="$2" ;;
					*columns ) OVERRIDE_COLUMNS="$2" ;;
					*lines   ) OVERRIDE_LINES="$2" ;;
					*rttmin  ) RTT_MIN="$2" ;;
					*rttmax  ) RTT_MAX="$2" ;;
				esac
				shift
				;;

			* )
				PING_PARAMS+=("$1")
				;;
		esac
		shift
	done

	is_uint "${LAST_N}"           || die "Invalid --last value: ${LAST_N}"
	is_uint "${OVERRIDE_COLUMNS}" || die "Invalid --columns value: ${OVERRIDE_COLUMNS}"
	is_uint "${OVERRIDE_LINES}"   || die "Invalid --lines value: ${OVERRIDE_LINES}"
	[[ "${RTT_MIN}" = auto ]] && RTT_MIN=0
	[[ "${RTT_MAX}" = auto ]] && RTT_MAX=0
	is_number "${RTT_MIN}" || die "Invalid --rttmin value: ${RTT_MIN}"
	is_number "${RTT_MAX}" || die "Invalid --rttmax value: ${RTT_MAX}"
	if ! command -v "${AWK_BIN}" > /dev/null 2>&1 ; then
		die "Cannot find the awk interpreter: ${AWK_BIN}"
	fi
	if ! "${AWK_BIN}" -v a="${RTT_MIN}" -v b="${RTT_MAX}" 'BEGIN { exit !(a <= 0 || b <= 0 || a < b) }' ; then
		die "Invalid --rttmin and --rttmax values."
	fi

	case "${COLOR_DEPTH}" in
		16 | 256 ) ;;
		24 | 24bit | truecolor | true ) COLOR_DEPTH=24 ;;
		auto )
			case "${COLORTERM}" in
				truecolor | 24bit ) COLOR_DEPTH=24 ;;
				* )
					case "${TERM}" in
						*-direct* ) COLOR_DEPTH=24 ;;
						*256col* ) COLOR_DEPTH=256 ;;
						* ) COLOR_DEPTH=16 ;;
					esac
					;;
			esac
			;;
		* ) die "Invalid --colors value: ${COLOR_DEPTH} (use 16, 256 or 24)" ;;
	esac

	case "${THEME}" in
		auto | dark | light ) ;;
		* ) die "Invalid --theme value: ${THEME} (use dark, light or auto)" ;;
	esac

	# https://no-color.org/
	if [[ -n "${NO_COLOR}" && "${FORCED_COLOR}" = 0 ]] ; then
		USE_COLOR=0
	fi

	if [[ "${#PING_PARAMS[@]}" = 0 ]] ; then
		die "Missing parameters, use --help for instructions."
	fi

	# A few ping parameters change how the output should be read: the packet
	# count, the interval, and the destination (in case ping never prints its
	# own header, which ping6 does not do while nothing comes back).
	COUNT=0
	INTERVAL=1
	TARGET=""
	local i p skip=0
	for (( i = 0 ; i < ${#PING_PARAMS[@]} ; i++ )) ; do
		p="${PING_PARAMS[i]}"
		if [[ "${skip}" = 1 ]] ; then
			skip=0
			continue
		fi
		case "${p}" in
			-c ) COUNT="${PING_PARAMS[i+1]}" ; skip=1 ;;
			-c* ) COUNT="${p#-c}" ;;
			-i ) INTERVAL="${PING_PARAMS[i+1]}" ; skip=1 ;;
			-i* ) INTERVAL="${p#-i}" ;;
			-* ) ;;
			* ) is_number "${p}" || TARGET="${p}" ;;
		esac
	done
	is_uint "${COUNT}" || COUNT=0
	is_number "${INTERVAL}" || INTERVAL=1

	# Workaround for mawk:
	# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=593504
	local version="$(echo | "${AWK_BIN}" -W version 2>&1)"
	if [[ "${version}" == mawk* ]] ; then
		AWK_PARAMS+=(-W interactive)
	fi
}

# While the graph is being drawn, typed characters (and the ^C echo) would be
# printed over it, and ^C would make the terminal drop output that awk already
# wrote. Both are switched off until prettyping exits. stty works on its
# standard input, hence /dev/tty: stdin may well be something else.
prepare_terminal() {
	SAVED_STTY=""
	if [[ "${IS_TERMINAL}" = 1 && -t 1 ]] ; then
		SAVED_STTY="$(stty -g 2> /dev/null < /dev/tty)"
	fi
	if [[ -n "${SAVED_STTY}" ]] ; then
		stty -echo 2> /dev/null < /dev/tty
		stty noflsh 2> /dev/null < /dev/tty
	fi

	# The awk side animates the status panel on these ticks.
	TICK=1
	if [[ "${IS_TERMINAL}" = 1 ]] && sleep 0.01 2> /dev/null ; then
		TICK=0.25
	fi
}

# Keys typed while echo was off were never shown: they are dropped, rather
# than handed to the shell to run.
discard_typeahead() {
	stty -icanon min 0 time 0 2> /dev/null < /dev/tty && cat > /dev/null 2>&1 < /dev/tty
}

restore_terminal() {
	if [[ -n "${SAVED_STTY}" ]] ; then
		discard_typeahead
		stty "${SAVED_STTY}" 2> /dev/null < /dev/tty
	fi
	if [[ "${IS_TERMINAL}" = 1 ]] ; then
		# awk shows the cursor again on its way out, unless it was killed.
		printf '\033[?25h'
	fi
}

# Killed (by timeout(1), or the terminal going away): leave the terminal as it
# was. bash runs this once the pipeline is gone, which happens at once when
# the signal went to all of it.
on_fatal_signal() {
	trap '' TTOU
	restore_terminal
	if [[ "${IS_TERMINAL}" = 1 && "${USE_TITLE}" = 1 ]] ; then
		printf '\033[23;2t'
	fi
	exit "$1"
}

# ^Z: give the terminal back as it was, then stop the whole pipeline. bash 3.2
# runs this trap a second time when the pipeline continues, as if the ^Z were
# still pending; that second run must not stop everything again.
on_tstp() {
	if [[ -n "${IN_TSTP}" ]] ; then
		return
	fi
	IN_TSTP=1
	if [[ -n "${SAVED_STTY}" ]] ; then
		discard_typeahead
		stty "${SAVED_STTY}" 2> /dev/null < /dev/tty
	fi
	printf '\033[?25h' 2> /dev/null > /dev/tty
	if [[ "${USE_TITLE}" = 1 ]] ; then
		printf '\033[23;2t' 2> /dev/null > /dev/tty
	fi
	kill -STOP 0
	IN_TSTP=""
}

# fg: take the terminal again, and tell awk to carry on below whatever the
# shell printed in the meantime.
on_cont() {
	if [[ -n "${SAVED_STTY}" ]] ; then
		stty -echo 2> /dev/null < /dev/tty
		stty noflsh 2> /dev/null < /dev/tty
	fi
	echo SIGCONT
}

# For --theme auto: is the terminal background light or dark? COLORFGBG says
# so in some terminals; otherwise the terminal is asked (OSC 11), and most
# answer within milliseconds. Without an answer, it is dark.
detect_theme() {
	local bg saved reply re r g b
	if [[ "${THEME}" != auto ]] ; then
		return
	fi
	THEME=dark
	if [[ -n "${COLORFGBG}" ]] ; then
		bg="${COLORFGBG##*;}"
		case "${bg}" in
			7 | 9 | 1[0-5] ) THEME=light ;;
		esac
		return
	fi
	if [[ "${IS_TERMINAL}" != 1 || "${USE_COLOR}" != 1 || ! -t 1 ]] ; then
		return
	fi
	saved="$(stty -g 2> /dev/null < /dev/tty)"
	if [[ -z "${saved}" ]] ; then
		return
	fi
	# Wait at most 0.2 s for the answer.
	stty -echo -icanon min 0 time 2 2> /dev/null < /dev/tty || return
	printf '\033]11;?\033\\' 2> /dev/null > /dev/tty
	reply="$(dd bs=64 count=1 2> /dev/null < /dev/tty)"
	stty "${saved}" 2> /dev/null < /dev/tty
	re='rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)'
	if [[ "${reply}" =~ ${re} ]] ; then
		r=$(( 16#${BASH_REMATCH[1]:0:2} ))
		g=$(( 16#${BASH_REMATCH[2]:0:2} ))
		b=$(( 16#${BASH_REMATCH[3]:0:2} ))
		if (( r * 299 + g * 587 + b * 114 > 128000 )) ; then
			THEME=light
		fi
	fi
}

MYNAME=`basename "$0"`
parse_arguments "$@"
detect_theme


export LC_ALL=C

# The awk program, which reads the output of ping and draws everything. It is
# a single-quoted string, so it must never contain an apostrophe, not even in
# a comment. (Keeping it in a variable also keeps it out of the job notices
# bash prints when a member of the pipeline dies.)
AWK_PROG='
############################################################
# Small helpers

# Weird that awk does not come with abs(), so I need to implement it.
function abs(x) {
	return ( (x < 0) ? -x : x )
}

function lesser(a, b) {
	return (a < b) ? a : b
}

function greater(a, b) {
	return (a > b) ? a : b
}

# Repeats s, n times.
function rep(s, n,   r) {
	r = ""
	while ( n-- > 0 ) r = r s
	return r
}

# Display width of s, which must not contain escape codes. With LC_ALL=C awk
# counts bytes, so the UTF-8 continuation bytes are discounted. Every glyph
# printed by this script is one column wide.
function vis(s,   t) {
	t = s
	return length(s) - gsub(/[\200-\277]/, "", t)
}

function lpad(s, w) {
	return rep(" ", w - vis(s)) s
}

function rpad(s, w) {
	return s rep(" ", w - vis(s))
}

# Text that came from outside (host names, ping messages) is printed as plain
# ASCII, so that it can neither move the cursor nor break the layout.
function sanitize(s) {
	gsub(/[^ -~]/, "?", s)
	return s
}

# Cuts s (no escape codes) to w columns, cell by cell, so that no UTF-8
# character is split.
function cut(s, w,   n, k, i, out) {
	if ( w <= 0 ) return ""
	if ( vis(s) <= w ) return s
	n = cells_of(s, CUTC)
	k = (w <= length(G_ELLIPSIS_A)) ? w : w - length(G_ELLIPSIS_A)
	out = ""
	for ( i = 1 ; i <= k && i <= n ; i++ ) out = out CUTC[i]
	return (k < w) ? out G_ELLIPSIS_A : out
}

# Three significant digits: 0.523, 5.23, 52.3, 523, 5230.
function fmt3(x) {
	if ( x < 0 ) x = 0
	if ( x < 0.9995 ) return sprintf("%.3f", x)
	if ( x < 9.995 ) return sprintf("%.2f", x)
	if ( x < 99.95 ) return sprintf("%.1f", x)
	return sprintf("%d", int(x + 0.5))
}

# Percentages: 0%, 0.40%, 2.5%, 12%, 99.6%, 100%.
function fmt_pct(p) {
	if ( p <= 0 ) return "0%"
	if ( p >= 100 ) return "100%"
	if ( p < 0.01 ) return "<0.01%"
	if ( p < 1 ) return sprintf("%.2f%%", p)
	if ( p < 10 ) return sprintf("%.1f%%", p)
	if ( p < 99 ) return sprintf("%d%%", int(p + 0.5))
	return sprintf("%.1f%%", p)
}

# Milliseconds for the scale and the histogram: 0.5 ms, 20 ms, 2 s.
function fmt_ms(x) {
	if ( x >= 1000 ) return fmt_num(x / 1000) " s"
	return fmt_num(x) " ms"
}

function fmt_num(x) {
	return sprintf("%g", x)
}

function fmt_dur(s) {
	s = int(s)
	if ( s < 60 ) return s "s"
	if ( s < 3600 ) return int(s / 60) "m" sprintf("%02d", s % 60) "s"
	if ( s < 86400 ) return int(s / 3600) "h" sprintf("%02d", int(s / 60) % 60) "m"
	return int(s / 86400) "d" sprintf("%02d", int(s / 3600) % 24) "h"
}

# Largest power of ten not above x, as an exponent.
function floor_log10(x,   e) {
	e = int(log(x) / LOG10)
	if ( 10 ^ e > x ) e--
	if ( 10 ^ (e + 1) <= x ) e++
	return e
}

# Rounds x down (or up) to a round number: 1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6
# or 8 times a power of ten.
function nice(x, up,   f, m, i) {
	f = 10 ^ floor_log10(x)
	m = x / f
	if ( up ) {
		for ( i = 1 ; i <= NICE_N ; i++ ) if ( NICE[i] >= m - 0.0001 ) return NICE[i] * f
		return 10 * f
	}
	for ( i = NICE_N ; i > 1 ; i-- ) if ( NICE[i] <= m + 0.0001 ) return NICE[i] * f
	return f
}

# Sorts a[1..n] in place (Shell sort, as awk has no portable sort).
function sort_n(a, n,   gap, i, j, t) {
	for ( gap = int(n / 2) ; gap > 0 ; gap = int(gap / 2) ) {
		for ( i = gap + 1 ; i <= n ; i++ ) {
			t = a[i]
			for ( j = i ; j > gap && a[j - gap] > t ; j -= gap ) {
				a[j] = a[j - gap]
			}
			a[j] = t
		}
	}
}

############################################################
# Clock

# Seconds since the epoch. Plain awk has no clock, but srand() returns the
# previous seed, and srand() without an argument seeds from the time of day.
# mawk seeds with nanoseconds, hence the scaling. If even that does not give
# a sane value, date(1) is asked instead.
function now(   t, cmd) {
	if ( CLOCK_SRAND ) {
		srand()
		t = srand()
		while ( t > 1e11 ) t /= 1000
		return t
	}
	cmd = "date +%s"
	t = 0
	cmd | getline t
	close(cmd)
	return t + 0
}

# Refreshes NOW, but without starting a date process for every reply.
function refresh_now() {
	if ( CLOCK_SRAND || !IS_TERMINAL || NOW == 0 ) NOW = now()
}

function clock_init(   cmd, d, D, t) {
	cmd = "date \"+%s %H %M %S\""
	d = ""
	cmd | getline d
	close(cmd)
	split(d, D, " ")
	EPOCH0 = D[1] + 0
	if ( EPOCH0 > 1e9 ) {
		TZOFF = (D[2] * 3600 + D[3] * 60 + D[4]) - (EPOCH0 % 86400)
		while ( TZOFF > 50400 ) TZOFF -= 86400
		while ( TZOFF < -50400 ) TZOFF += 86400
	} else {
		TZOFF = 0
	}
	CLOCK_SRAND = 1
	t = now()
	if ( t < 1e9 || (EPOCH0 > 1e9 && abs(t - EPOCH0) > 5) ) CLOCK_SRAND = 0
	NOW = now()
	START_T = NOW
}

# Local time of day, HH:MM:SS.
function clock(t,   s) {
	s = (int(t) + TZOFF) % 86400
	if ( s < 0 ) s += 86400
	return sprintf("%02d:%02d:%02d", int(s / 3600), int(s / 60) % 60, s % 60)
}

############################################################
# Colors

# Escape code for a 24-bit color (bg=1 for the background), reduced to the
# 256-color palette when the terminal cannot show more.
function rgb(r, g, b, bg) {
	if ( !USE_COLOR ) return ""
	r = int(r) ; g = int(g) ; b = int(b)
	if ( DEPTH == 24 ) return CSI (bg ? "48" : "38") ";2;" r ";" g ";" b "m"
	return CSI (bg ? "48" : "38") ";5;" cube256(r, g, b) "m"
}

function cube256(r, g, b,   gray, i) {
	if ( greater(r, greater(g, b)) - lesser(r, lesser(g, b)) < 32 ) {
		gray = (r + g + b) / 3
		if ( gray < 4 ) return 16
		if ( gray > 246 ) return 231
		i = int((gray - 8) / 10 + 0.5)
		if ( i < 0 ) i = 0
		if ( i > 23 ) i = 23
		return 232 + i
	}
	return 16 + 36 * c6(r) + 6 * c6(g) + c6(b)
}

function c6(v) {
	if ( v < 48 ) return 0
	if ( v < 115 ) return 1
	return int((v - 35) / 40)
}

# A color for the interface: an RGB value, or the given SGR attributes on a
# 16-color terminal.
function ui(r, g, b, basic) {
	if ( !USE_COLOR ) return ""
	if ( DEPTH == 16 ) return CSI basic "m"
	return rgb(r, g, b, 0)
}

# The latency gradient: p goes from 0 (fast, cool colors) to 1 (slow, hot).
function heat(p,   i, f) {
	if ( !USE_COLOR ) return ""
	if ( !USE_MULTICOLOR ) p = 0.25
	if ( p < 0 ) p = 0
	if ( p > 1 ) p = 1
	if ( DEPTH == 16 ) {
		# Red is kept for lost packets.
		if ( p < 0.45 ) return CSI "32m"
		if ( p < 0.68 ) return CSI "33m"
		return CSI "35m"
	}
	i = 1
	while ( i < HEAT_N - 1 && p > HEAT_P[i] ) i++
	f = (p - HEAT_P[i - 1]) / (HEAT_P[i] - HEAT_P[i - 1])
	return rgb(HEAT_R[i - 1] + (HEAT_R[i] - HEAT_R[i - 1]) * f, \
	           HEAT_G[i - 1] + (HEAT_G[i] - HEAT_G[i - 1]) * f, \
	           HEAT_B[i - 1] + (HEAT_B[i] - HEAT_B[i - 1]) * f, 0)
}

function heat_stop(p, r, g, b) {
	HEAT_P[HEAT_N] = p
	HEAT_R[HEAT_N] = r
	HEAT_G[HEAT_N] = g
	HEAT_B[HEAT_N] = b
	HEAT_N++
}

